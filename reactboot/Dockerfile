#=====================================================================
# weathertw 백엔드 이미지.
#
# 2단계로 나눈다(멀티 스테이지).
#   1단계 build   : JDK + 메이븐으로 jar 를 만든다.  이미지가 700MB 쯤 된다.
#   2단계 runtime : JRE 위에 완성된 jar 만 얹는다.   최종 이미지는 300MB 쯤.
# 최종 이미지에는 1단계의 흔적(소스코드, 메이븐, 컴파일러)이 하나도 남지 않는다.
#=====================================================================


# ---------------------------------------------------------------
# 1단계 · 빌드
# ---------------------------------------------------------------
# AS build 로 이름을 붙여둔다. 2단계에서 이 이름으로 결과물을 꺼내 온다.
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /build

# ⚠ pom.xml 만 먼저 복사한다. 소스와 같이 복사하지 않는다.
# 도커는 명령 한 줄을 "레이어" 하나로 캐시한다. 앞 줄의 입력이 안 바뀌면
# 그 줄은 통째로 건너뛴다.
#   같이 복사하면 → 소스 한 글자만 고쳐도 의존성 수백 개를 매번 새로 받는다.
#   따로 복사하면 → pom.xml 이 그대로인 한 아래 RUN 은 캐시로 0초에 끝난다.
COPY pom.xml .
RUN mvn -B dependency:go-offline

# 이제 소스를 복사한다. 여기부터가 자주 바뀌는 부분이다.
COPY src ./src

# 테스트는 건너뛴다. 이 프로젝트의 테스트는 DB·Redis·시크릿을 전부 요구해서
# 빌드 단계(네트워크도 DB 도 없는 곳)에서는 어차피 못 돈다.
RUN mvn -B -DskipTests package


# ---------------------------------------------------------------
# 2단계 · 실행
# ---------------------------------------------------------------
# jre = 자바를 "실행"만 하는 최소 구성. jdk(컴파일러 포함)보다 훨씬 작다.
# jammy = 우분투 22.04 유저랜드. 커널은 없다(호스트 것을 공유).
FROM eclipse-temurin:17-jre-jammy

# 컨테이너 안 시계. 없으면 UTC 로 돌아서 로그 시각과 예약 작업이 9시간 어긋난다.
ENV TZ=Asia/Seoul

# root 로 돌리지 않는다. 앱이 뚫려도 컨테이너 안에서 할 수 있는 게 줄어든다.
RUN useradd --system --create-home --uid 1001 app

WORKDIR /app

# 1단계에서 만든 jar 만 꺼내 온다. 소스도 메이븐도 안 따라온다.
# *.jar 로 쓰면 버전이 올라가도 이 줄을 안 고쳐도 된다.
# (target 에 같이 생기는 .jar.original 은 확장자가 달라서 안 걸린다)
COPY --from=build /build/target/*.jar app.jar

# 업로드 이미지가 저장될 곳. compose 가 여기에 볼륨을 꽂는다.
# 미리 만들고 소유자를 app 으로 바꿔둬야 볼륨도 그 소유권을 물려받는다.
# (안 하면 root 소유가 되어 app 계정이 파일을 못 쓴다)
RUN mkdir -p /opt/weathertw/uploads && chown -R app:app /opt/weathertw /app

USER app

# "이 컨테이너는 8081 을 쓴다"는 문서 표시. 실제 개방은 compose 의 ports 가 한다.
EXPOSE 8081

# MaxRAMPercentage : 자바에게 "컨테이너에 허용된 메모리의 75%까지 써라" 라고 알려준다.
# 안 주면 JVM 이 호스트 전체 메모리를 기준으로 힙을 잡아서, 메모리 제한이 걸린
# 서버에서 OOM 으로 컨테이너가 통째로 죽는다.
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=75", "-jar", "/app/app.jar"]
