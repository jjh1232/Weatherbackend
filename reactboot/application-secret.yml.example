# 이 파일을 application-secret.yml 로 복사한 뒤 값을 채우면 로컬에서 바로 실행된다.
#   cp application-secret.yml.example application-secret.yml
#
# 서버(오라클 등)에서는 이 파일 대신 같은 이름의 환경변수를 주입한다.
#   systemd:  EnvironmentFile=/etc/weathertw/app.env
#
# ⚠ 채운 application-secret.yml 은 절대 커밋하지 말 것 (.gitignore 에 등록돼 있음)

# --- MySQL ---
DB_USERNAME:
DB_PASSWORD:

# --- Gmail SMTP (구글 계정 > 보안 > 앱 비밀번호) ---
MAIL_USERNAME:
MAIL_PASSWORD:

# --- 구글 OAuth2 (GCP 콘솔 > 사용자 인증 정보) ---
GOOGLE_CLIENT_ID:
GOOGLE_CLIENT_SECRET:

# --- 네이버 OAuth2 (네이버 개발자센터) ---
NAVER_CLIENT_ID:
NAVER_CLIENT_SECRET:

# --- JWT 서명키 (HS512, 충분히 길게) ---
#   생성: openssl rand -base64 64
JWT_SECRET:

# --- 기상청 단기예보 API (data.go.kr) 일반 인증키(Encoding) ---
WEATHER_API_KEY:
