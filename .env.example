# 이 파일을 .env 로 복사한 뒤 값을 채우면 docker compose 가 바로 돈다.
#   cp .env.example .env
#
# 값의 출처는 reactboot/application-secret.yml 이다. 둘이 달라지면 앱이 DB 에 못 붙는다.
# ⚠ 채운 .env 는 절대 커밋하지 말 것 (.gitignore 에 등록돼 있음)

# --- MySQL 컨테이너 초기화용 ---
MYSQL_ROOT_PASSWORD=
DB_NAME=spring5fs
DB_USERNAME=
DB_PASSWORD=

# --- Redis 컨테이너용 ---
# 생성 예)  openssl rand -hex 24
REDIS_PASSWORD=

# --- 배포 도메인 ---
# 백엔드 자신의 공개 주소. OAuth 콜백과 인증 메일 링크가 이 값으로 만들어진다.
APP_BASE_URL=
APP_FRONTEND_URL=
# 쉼표로 여러 개 · 끝 슬래시 금지
APP_CORS_ORIGINS=
